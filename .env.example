# 提示词工坊 PromptForge · Web 版环境变量示例
# 用法: cp .env.example .env 后填写。docker compose 会自动读取同目录 .env

# 平台口令: 管理员登录的第三因子 (用户名+密码+平台口令 三重认证)。
# 强烈建议设置; 留空则管理员不校验口令 (仅限内网测试)。
WEB_ACCESS_PASSWORD=change-me-platform-passphrase

# 内置管理员 admin 的初始密码 (仅首次启动建号时使用, 登录后请尽快修改)。
# 留空则系统随机生成并在 docker logs 里打印一次。
WEB_ADMIN_PASSWORD=change-me-admin-password

# 可选: 注入模型 API Key (优先于所有用户在界面里保存的值, 避免密钥落库)
# PROMPTFORGE_API_KEY=sk-xxxx

# 可选: 会话 Cookie Secure 属性。HTTPS/反向代理部署建议设为 1
# (浏览器仅在加密连接回传会话 Cookie); HTTP 内网直部署保持默认 0。
# WEB_COOKIE_SECURE=0
